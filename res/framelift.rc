#include <winver.h>
#include "version.h"
1 ICON "framelift.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION FL_VER_MAJOR,FL_VER_MINOR,FL_VER_PATCH,0
PRODUCTVERSION FL_VER_MAJOR,FL_VER_MINOR,FL_VER_PATCH,0
FILEFLAGSMASK 0x3fL
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "FrameLift - frame generation for capture cards"
      VALUE "ProductName", "FrameLift"
      VALUE "FileVersion", FL_VER_STRING
      VALUE "ProductVersion", FL_VER_STRING
      VALUE "OriginalFilename", "FrameLift.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
