# Copy to tools/testpc.env (ignored by git) and fill in your Windows test PC.
# The PC needs OpenSSH Server, a GPU, and FrameLift's bench folder at C:\FrameLift\bench.
FL_SSH=(user@my-windows-pc)          # ssh arguments
FL_SCP_HOST="user@my-windows-pc"     # scp host
FL_SCP_OPTS=()                       # extra scp options
FL_USER='user'                       # Windows account that is signed in at the desktop
